# Socket Mode app-level token and its refresh token (shown only once by Slack).
SLACK_APP_TOKEN=xoxe.xapp-your-app-token
SLACK_APP_REFRESH_TOKEN=xoxe-your-app-refresh-token
# Basic Information > App Credentials; required for oauth.v2.access.
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
# Optional: persistent token cache (default: .slack-app-tokens.json in this directory).
# SLACK_APP_TOKEN_FILE=/absolute/path/to/slack-app-tokens.json

# Optional: native host binary and timeout.
# TIMESLAY_BIN=timeslay
# TIMESLAY_TIMEOUT_MS=30000

# Enable unlisted distribution in Slack and set
# this exact HTTPS redirect URL in OAuth & Permissions. Forward /slack/* to
# http://127.0.0.1:3000. The bridge prints a private installation link at startup.
SLACK_REDIRECT_URI=https://your-host/slack/oauth/callback
# SLACK_OAUTH_PORT=3000
# SLACK_INSTALLATIONS_FILE=/absolute/path/to/slack-installations.json
# Only the account authorizing each workspace can add to your local inbox.
# Keep bot OAuth token rotation disabled (separate from app-level rotation).
