// Vendored from package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0
// so loading the config needs no network (GitHub 504s on the "@" asset URL).
// Keep in sync with the hk version in mise.toml.
amends ".hk/Config.pkl"

// Pre-commit skips --all-targets so it doesn't compile every test, example and
// bench on each commit; `hk check`/`hk fix` (and CI) still lint all targets.
local function linters(allTargets: Boolean) = new Mapping<String, Step> {
  ["clippy"] {
    glob = List("**/*.rs", "**/Cargo.toml", "Cargo.lock")
    exclude = List("vendor/**")
    // Cargo must analyze whole crates, but the helper only edits selected files.
    check = "cargo clippy --workspace \(if (allTargets) "--all-targets " else "")--locked -- -D warnings"
    fix = "python3 scripts/clippy-fix.py \(if (allTargets) "--all-targets " else ""){{files}}"
    check_first = false
    exclusive = true
  }
  ["rustfmt"] {
    glob = List("**/*.rs")
    exclude = List("vendor/**")
    depends = List("clippy")
    // Without skip_children, formatting lib.rs/main.rs also formats other modules.
    check = "rustfmt --edition 2024 --config skip_children=true --check {{files}}"
    fix = "rustfmt --edition 2024 --config skip_children=true {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
    steps = linters(false)
  }
  ["check"] {
    fix = false
    stage = false
    steps = linters(true)
  }
  ["fix"] {
    fix = true
    stage = false
    steps = linters(true)
  }
}
