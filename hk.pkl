// Vendored from package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0
// so loading the config needs no network (GitHub 504s on the "@" asset URL).
// Keep in sync with the hk version in mise.toml.
amends ".hk/Config.pkl"

local linters = new Mapping<String, Step> {
  ["rustfmt"] {
    glob = List("**/*.rs")
    exclude = List("vendor/**")
    // Without skip_children, formatting lib.rs/main.rs also formats other modules.
    check = "rustfmt --edition 2024 --config skip_children=true --check {{files}}"
    fix = "rustfmt --edition 2024 --config skip_children=true {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
    steps = linters
  }
  ["check"] {
    fix = false
    stage = false
    steps = linters
  }
  ["fix"] {
    fix = true
    stage = false
    steps = linters
  }
}
