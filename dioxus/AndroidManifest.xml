<?xml version="1.0" encoding="utf-8"?>
<!--
  Replaces the manifest `dx` generates (see `application.android_manifest` in
  Dioxus.toml). It matches the generated one except that it opts out of Auto
  Backup. Tokens also live in getNoBackupFilesDir(), which excludes them from
  device transfers even on devices that ignore allowBackup for transfers.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The widget's background sync waits for a network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application android:hasCode="true" android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity android:configChanges="orientation|screenLayout|screenSize|keyboardHidden" android:exported="true"
            android:label="@string/app_name" android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The day view widget. Its sources are in android/; scripts/build-android.sh
             adds them to the project `dx` generates. -->
        <receiver android:name="dev.timeslay.day.widget.DayWidgetProvider"
            android:exported="false"
            android:label="@string/day_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.timeslay.day.widget.DATA_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/day_widget_info" />
        </receiver>
        <service android:name="dev.timeslay.day.widget.DayWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <!-- A separate process, because the native library's Android context is
             set up once per process and the activity's own setup must not race it. -->
        <service android:name="dev.timeslay.day.widget.WidgetRefreshService"
            android:exported="false"
            android:process=":widget"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
